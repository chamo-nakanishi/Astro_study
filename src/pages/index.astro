---
// ここは frontmatter と呼ばれる場所です。
// ページを表示する前に、Astroがサーバー側でこのJavaScriptを実行します。

// ページのタイトルとして使う文字列です。
const pageTitle = "Astro テスト";

// 今日の日付を日本の表記で作っています。
const today = new Date().toLocaleDateString("ja-JP");

// 箇条書きで表示する内容を、配列としてまとめています。
const learningPoints = [
  "frontmatterの中ではJavaScriptを書くことができます。",
  "{} を使うと、JavaScriptの値をHTMLに表示できます。",
  "配列は map() を使って、箇条書きとして表示できます。",
  "このファイル内のCSSは、このページの見た目を整えます。"
];

// あいさつ文の中で使う名前です。
const userName = "Chamoさん";

// 共通ヘッダー用のAstroコンポーネントを読み込んでいます。
import Header from "../components/Header.astro";

// 共通ボタン用のAstroコンポーネントを読み込んでいます。
import Button from "../components/Button.astro";

// サイト全体で使うCSSファイルを読み込んでいます。
import "../styles/global.css";
---

<!-- ここから下は、ブラウザに表示されるHTMLです。 -->
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- {} を使うと、frontmatterで用意したJavaScriptの値をHTMLに差し込めます。 -->
    <title>{pageTitle}</title>
  </head>
  <body>
    <!-- Headerコンポーネントをここに表示しています。 -->
    <Header />

    <main>
      <!-- today の中身がここに表示されます。 -->
      <p class="eyebrow">今日の日付: {today}</p>

      <!-- pageTitle の中身が見出しとして表示されます。 -->
      <h1>{pageTitle}</h1>

      <!-- userName の中身を文章の途中に差し込んでいます。 -->
      <p class="lead">こんにちは、{userName}。これはAstroの練習用ページです。</p>

      <!-- text と href を渡して、共通ボタンの表示内容を変えています。 -->
      <Button text="下層ページを見る" href="/about/" />

      <section>
        <h2>このページで学べること</h2>
        <ul>
          <!-- map() で配列の中身を1つずつ <li> に変換しています。 -->
          {learningPoints.map((point) => <li>{point}</li>)}
        </ul>
      </section>

      <section class="note">
        <h2>試してみよう</h2>
        <p>
          <code>src/pages/index.astro</code> を編集して保存すると、
          開発サーバーが動いている間はブラウザの表示も更新されます。
        </p>
      </section>
    </main>
  </body>
</html>
