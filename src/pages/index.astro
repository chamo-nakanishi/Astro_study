---
const pageTitle = "Astro テスト";
const today = new Date().toLocaleDateString("ja-JP");

const learningPoints = [
  "The frontmatter block runs on the server.",
  "JavaScript values can be inserted into HTML with braces.",
  "Arrays can be rendered with map().",
  "Styles in an Astro file are scoped to this page."
];

const userName = "Astro learner";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">Today: {today}</p>
      <h1>{pageTitle}</h1>
      <p class="lead">Hello, {userName}. This is your first tiny Astro page.</p>

      <section>
        <h2>What this page shows</h2>
        <ul>
          {learningPoints.map((point) => <li>{point}</li>)}
        </ul>
      </section>

      <section class="note">
        <h2>Try changing it</h2>
        <p>
          Edit <code>src/pages/index.astro</code>, save the file, and the browser
          will update while the dev server is running.
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family:
      Inter, "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    background: #f7f3ea;
    color: #1f2933;
  }

  main {
    width: min(720px, calc(100% - 32px));
    margin: 64px auto;
  }

  .eyebrow {
    color: #7c3aed;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 16px;
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 1;
  }

  h2 {
    margin-top: 32px;
  }

  .lead {
    font-size: 1.25rem;
    line-height: 1.6;
  }

  li {
    margin: 10px 0;
  }

  .note {
    border-left: 4px solid #f97316;
    margin-top: 32px;
    padding: 8px 0 8px 20px;
    background: #fffaf0;
  }

  code {
    background: #e5e7eb;
    border-radius: 4px;
    padding: 2px 6px;
  }
</style>
